# SpeechPrep — environment variables.
# Copy to .env.local for local development. Production values live in
# Vercel (app) and Supabase Edge Function secrets (pipeline).

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://newkdnxxgeeangtgvabn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the admin client for cross-user pipeline writes.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI coach ----------
# Anthropic key for the unified coach (web/src/lib/ai-coach.ts). If
# unset, sessions still transcribe but no coach report is generated.
ANTHROPIC_API_KEY=

# Shared pipeline trigger secret. Two jobs:
#   1. The transcribe edge function POSTs ${SITE_URL}/api/coach/run with
#      header `x-coach-trigger: <this value>` to generate the report.
#   2. The transcribe edge function itself requires the same header on
#      inbound requests (it is not an open endpoint).
# Set the SAME value in three places: this app (Vercel env), and the
# transcribe edge function's secrets (COACH_TRIGGER_SECRET + SITE_URL).
# Generate with: openssl rand -hex 32
COACH_TRIGGER_SECRET=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids for the subscription + one-shot products.
PRACTICED_PRICE_MONTHLY=
PRACTICED_PRICE_YEARLY=
SINGLE_SPEECH_PRICE=

# ---------- Email ----------
RESEND_API_KEY=

# ---------- Google Ads conversions ----------
# send_to labels ("AW-XXXXXXXXXXX/AbC-dEfGhIjKlMnOp") for the two conversion
# actions — create them in the Google Ads UI first (docs/analytics.md →
# "Google Ads conversion setup"). Leave unset and conversion firing is a
# clean no-op, so these are safe to omit until ads are relit.
# Primary: purchase on /app/billing/success (dynamic value, ~24 USD).
NEXT_PUBLIC_GADS_CONVERSION_PURCHASE=
# Secondary: first coach report delivered (the activation signal).
NEXT_PUBLIC_GADS_CONVERSION_REPORT=

# ---------- Cron / observability ----------
# Bearer secret for /api/cron/* routes (GitHub Actions scheduler).
CRON_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
# Statsig session replay. The CLIENT key ("client-..."), from Statsig
# console > Project Settings > Keys & Environments — not the server secret.
# Leave unset and the recorder never boots (docs/analytics.md → "Session
# replay"). Safe to omit locally; set it in Vercel for Production only if
# you don't want preview traffic in the replay feed.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" only on the production deployment that should be indexed.
NEXT_PUBLIC_INDEXABLE=false
