# SpeechPrep — environment template. Copy to .env.local for development;
# mirror in the Vercel project settings for prod.

# ---- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://newkdnxxgeeangtgvabn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only. Used by the Stripe webhook, entitlements,
# and the funnel event writer (src/lib/track.ts). Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI --------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Shared secret between the transcribe edge function and /api/coach/run.
INTERNAL_COACH_SECRET=

# ---- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids for the two products.
PRACTICED_PRICE_MONTHLY=
PRACTICED_PRICE_YEARLY=
SINGLE_SPEECH_PRICE=

# ---- Google Ads conversions ------------------------------------------------
# send_to labels ("AW-XXXXXXXXXXX/AbC-dEfGhIjKlMnOp") for the two conversion
# actions — create them in the Google Ads UI first (docs/analytics.md →
# "Google Ads conversion setup"). Leave unset and conversion firing is a
# clean no-op, so these are safe to omit until ads are relit.
# Primary: purchase on /app/billing/success (dynamic value, ~24 USD).
NEXT_PUBLIC_GADS_CONVERSION_PURCHASE=
# Secondary: first coach report delivered (the activation signal).
NEXT_PUBLIC_GADS_CONVERSION_REPORT=

# ---- Site ------------------------------------------------------------------
# "true" only on the production domain — controls robots/indexing.
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=https://speechprep.ai

# ---- Observability ---------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
